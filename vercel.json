{
  "cleanUrls": true,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/shopkeeper", "destination": "/shopkeeper.html" },
    { "source": "/customer", "destination": "/customer.html" },
    { "source": "/admin", "destination": "/shopkeeper.html" }
  ]
}
